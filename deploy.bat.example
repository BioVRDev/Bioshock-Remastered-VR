@echo off
rem ===========================================================================
rem  Local deploy -- copy this to deploy.bat and set GAME to your own path.
rem
rem  deploy.bat is gitignored because it contains a machine-specific path.
rem  This template is tracked so the correct layout is never lost again.
rem
rem  THE DESTINATION IS THE GAME FOLDER ITSELF, NOT A BioPlugins SUBFOLDER.
rem  Older versions of this script copied to %GAME%\BioPlugins\, which silently
rem  fails on a current install -- that folder does not exist. The mod DLL sits
rem  directly beside BioshockHD.exe, loaded by dxgi.dll.
rem ===========================================================================

set GAME="C:\Program Files (x86)\Steam\steamapps\common\BioShock Remastered\Build\Final"

copy /Y "%~dp0Release\BioshockVR.dll" %GAME%\BioshockVR.dll
if errorlevel 1 (
    echo.
    echo *** COPY FAILED. Run this as Administrator, or the game is still open. ***
    pause
    exit /b 1
)

rem The shim is a SEPARATE project and is only deployed when you have rebuilt
rem it. Uncomment if you are working on OpenXRShim -- and remember Setup.bat
rem selects the live loader by COPYING a pristine source, so overwriting
rem openxr_loader.dll directly bypasses that selection.
rem copy /Y "%~dp0Release\openxr_loader.dll" %GAME%\openxr_loader_steam.dll

echo Deployed OK.
timeout /t 1 >nul
